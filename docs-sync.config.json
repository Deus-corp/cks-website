{
  "_comment": "Config for scripts/sync-docs.py. dest paths are relative to the cks-website repo root. Adjust include/exclude/dest per source without touching the script itself.",

  "remove_orphaned": true,

  "protected": [
    "src/content/docs/index.mdx",
    "src/content/docs/faq.mdx",
    "src/content/docs/quickstart.mdx",
    "src/content/docs/demo.md",
    "src/content/docs/404.md",
    "src/content/docs/case-studies/**",
    "src/content/docs/cks-runtime/index.mdx",
    "src/content/docs/cks-studio/index.mdx"
  ],

  "sources": {
    "cks-core": {
      "repo": "cks-core",
      "include": [
        "docs/**"
      ],
      "exclude": [
        "docs/internal/**"
      ],
      "strip_prefix": "docs/",
      "dest": "src/content/docs/cks-core"
    },
    "cks-runtime": {
      "repo": "cks-runtime",
      "include": [
        "docs/**"
      ],
      "exclude": [
        "docs/internal/**"
      ],
      "strip_prefix": "docs/",
      "dest": "src/content/docs/cks-runtime"
    },
    "cks-mcp": {
      "repo": "cks-mcp",
      "include": [
        "docs/**"
      ],
      "exclude": [
        "docs/internal/**"
      ],
      "strip_prefix": "docs/",
      "dest": "src/content/docs/cks-mcp"
    },
    "cks-studio": {
      "repo": "cks-studio",
      "include": [
        "docs/**"
      ],
      "exclude": [
        "docs/internal/**"
      ],
      "strip_prefix": "docs/",
      "dest": "src/content/docs/cks-studio"
    }
  }
}
